{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "paths": {
      // go wails bindings alias
      "@services": [
        "./bindings/github.com/fool-pigeon/pigeon/cmd/pg-gui/service"
      ],
      "@services/*": [
        "./bindings/github.com/fool-pigeon/pigeon/cmd/pg-gui/service/*"
      ],
      "@internal": [
        "./bindings/github.com/fool-pigeon/pigeon/internal"
      ],
      "@internal/*": [
        "./bindings/github.com/fool-pigeon/pigeon/internal/*"
      ],
      "@pg/*": [
        "./bindings/github.com/fool-pigeon/pigeon/cmd/pg-gui/*"
      ],
      "@bindings/*": [
        "./bindings/*"
      ],
      // src alias
      "@type/*": [
        "./src/lib/types/*"
      ],
      "@comp/*": [
        "./src/lib/components/*"
      ],
      "@lib/*": [
        "./src/lib/*"
      ],
    },
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    /**
     * Typecheck JS in `.svelte` and `.js` files by default.
     * Disable checkJs if you'd like to use dynamic types in JS.
     * Note that setting allowJs false does not prevent the use
     * of JS in `.svelte` files.
     */
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "bindings"
  ],
}